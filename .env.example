# Environment Toggle (cloud | local)
EXPO_PUBLIC_APP_ENV=cloud

# TradeMasterBackend: ALL market data (search, charts, quotes, status, live ticks)
EXPO_PUBLIC_LOCAL_ORCHESTRATOR_URL=http://localhost:8000
EXPO_PUBLIC_CLOUD_ORCHESTRATOR_URL=https://trademasterbackend.onrender.com
# = SERVICE_API_KEY of the backend selected above (local and cloud may differ).
# EXPO_PUBLIC_* values are compiled into the app and can be extracted from it:
# this key must only ever unlock the backend, never Breeze / the broker account.
EXPO_PUBLIC_BACKEND_API_KEY=

# Paper trading (orders, positions, account, analytics) - user routes are open
EXPO_PUBLIC_PAPER_BACKEND_URL=https://trademaster-paper-trading-service.onrender.com/api/v1

# The app does NOT call the Breeze service directly any more (its key controls
# the real ICICI account). Do not add EXPO_PUBLIC_BREEZE_* here.
